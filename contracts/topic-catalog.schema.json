{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhot.example/contracts/topic-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "matchingRulesVersion", "topics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "matchingRulesVersion": { "const": "same-type-or-cross-type-and-v1" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/topic" }
    }
  },
  "$defs": {
    "editorialDomainId": {
      "enum": ["software-engineering", "model-research"]
    },
    "tagType": {
      "enum": ["domain", "lifecycle", "problem", "method"]
    },
    "tagFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagType", "anyOf"],
      "properties": {
        "tagType": { "$ref": "#/$defs/tagType" },
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["articleCount", "sourceCount", "dateFrom", "dateTo"],
      "properties": {
        "articleCount": { "type": "integer", "minimum": 2 },
        "sourceCount": { "type": "integer", "minimum": 2 },
        "dateFrom": { "type": "string", "format": "date" },
        "dateTo": { "type": "string", "format": "date" }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "topicVersion",
        "matchingRulesVersion",
        "statement",
        "boundary",
        "confirmedAt",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "topicVersion": { "type": "integer", "minimum": 1 },
        "matchingRulesVersion": { "const": "same-type-or-cross-type-and-v1" },
        "statement": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1 },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "name",
        "scope",
        "domains",
        "tagFilters",
        "currentMemberInsightIds"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/editorialDomainId" }
        },
        "tagFilters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/tagFilter" }
        },
        "currentMemberInsightIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^insight-[a-f0-9]{24}$"
          }
        },
        "latestConfirmedJudgment": { "$ref": "#/$defs/judgment" }
      }
    }
  }
}
