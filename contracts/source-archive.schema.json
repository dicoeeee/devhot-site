{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhot.example/contracts/source-archive.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "source", "title", "officialUrl", "contentDate"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "id": { "type": "string", "pattern": "^source-[a-f0-9]{24}$" },
    "insightId": { "type": "string", "pattern": "^insight-[a-f0-9]{24}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "title": { "type": "string", "minLength": 1 },
    "officialUrl": { "type": "string", "pattern": "^https://" },
    "contentDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "basis"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "basis": { "enum": ["published_at", "first_collected_at"] }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "parts"],
      "properties": {
        "format": { "enum": ["markdown", "pages"] },
        "parts": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetPath", "alt", "position"],
        "properties": {
          "assetPath": {
            "type": "string",
            "pattern": "^assets/sha256/[a-f0-9]{64}\\.png$"
          },
          "alt": { "type": "string" },
          "position": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "text"],
            "properties": {
              "kind": { "const": "text" },
              "text": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "assetPath", "alt"],
            "properties": {
              "kind": { "const": "image" },
              "assetPath": {
                "type": "string",
                "pattern": "^assets/sha256/[a-f0-9]{64}\\.png$"
              },
              "alt": { "type": "string" }
            }
          }
        ]
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "archivedAt", "contentSha256", "completeness"],
      "properties": {
        "status": { "const": "first_success_snapshot" },
        "archivedAt": { "type": "string", "format": "date-time" },
        "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "completeness": { "enum": ["complete", "partial"] }
      }
    },
    "insightUrl": { "type": "string", "pattern": "^/insights/insight-[a-f0-9]{24}/$" }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 1 } } },
      "then": {
        "required": ["insightId", "insightUrl", "body", "images"],
        "properties": {
          "insightId": {},
          "insightUrl": {},
          "body": {},
          "images": {},
          "content": false,
          "archive": false
        }
      },
      "else": {
        "required": ["content", "archive"],
        "properties": { "body": false, "images": false, "content": {}, "archive": {} },
        "oneOf": [
          {
            "properties": { "insightId": {}, "insightUrl": {} },
            "required": ["insightId", "insightUrl"]
          },
          {
            "not": {
              "anyOf": [
                { "properties": { "insightId": {} }, "required": ["insightId"] },
                { "properties": { "insightUrl": {} }, "required": ["insightUrl"] }
              ]
            }
          }
        ]
      }
    }
  ]
}
