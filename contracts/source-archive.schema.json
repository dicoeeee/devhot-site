{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhot.example/contracts/source-archive.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "insightId",
    "source",
    "title",
    "officialUrl",
    "contentDate",
    "body",
    "images",
    "insightUrl"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^source-[a-f0-9]{24}$" },
    "insightId": { "type": "string", "pattern": "^insight-[a-f0-9]{24}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "title": { "type": "string", "minLength": 1 },
    "officialUrl": { "type": "string", "pattern": "^https://" },
    "contentDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "basis"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "basis": { "enum": ["published_at", "first_collected_at"] }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "parts"],
      "properties": {
        "format": { "enum": ["markdown", "pages"] },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetPath", "alt", "position"],
        "properties": {
          "assetPath": {
            "type": "string",
            "pattern": "^assets/sha256/[a-f0-9]{64}\\.png$"
          },
          "alt": { "type": "string" },
          "position": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "insightUrl": {
      "type": "string",
      "pattern": "^/insights/insight-[a-f0-9]{24}/$"
    }
  }
}
