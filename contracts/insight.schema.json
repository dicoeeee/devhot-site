{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhot.example/contracts/insight.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "sourceId",
    "domain",
    "title",
    "contentDate",
    "summary",
    "mechanism",
    "keyInterpretation",
    "domainImplications",
    "tags",
    "citations",
    "sourceUrl",
    "officialUrl"
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "id": { "type": "string", "pattern": "^insight-[a-f0-9]{24}$" },
    "sourceId": { "type": "string", "pattern": "^source-[a-f0-9]{24}$" },
    "domain": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/editorialDomainId" }
    },
    "title": { "type": "string", "minLength": 1 },
    "contentDate": { "$ref": "#/$defs/contentDate" },
    "summary": { "type": "string", "minLength": 1 },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocks"],
      "properties": {
        "status": { "enum": ["present", "no_supported_content"] },
        "blocks": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/evidenceMechanismBlock" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "present" } } },
          "then": {
            "properties": { "blocks": { "type": "array", "minItems": 1 } }
          },
          "else": {
            "properties": { "blocks": { "type": "array", "maxItems": 0 } }
          }
        }
      ]
    },
    "keyInterpretation": { "type": "string", "minLength": 1 },
    "domainImplications": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "evidenceId", "quote"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^source-[a-f0-9]{24}$" },
          "evidenceId": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "modelDerived"],
      "properties": {
        "deterministic": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/deterministicRelation" }
        },
        "modelDerived": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/modelRelation" }
        }
      }
    },
    "sourceUrl": { "type": "string", "pattern": "^/sources/source-[a-f0-9]{24}/$" },
    "officialUrl": { "type": "string", "pattern": "^https://" }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 1 } } },
      "then": {
        "properties": {
          "relations": false,
          "mechanism": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "blocks"],
            "properties": {
              "status": { "enum": ["present", "no_supported_content"] },
              "blocks": {
                "type": "array",
                "items": { "$ref": "#/$defs/legacyMechanismBlock" }
              }
            }
          }
        }
      },
      "else": { "required": ["relations"], "properties": { "relations": {} } }
    }
  ],
  "$defs": {
    "editorialDomainId": { "enum": ["software-engineering", "model-research"] },
    "contentDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "basis"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "basis": { "enum": ["published_at", "first_collected_at"] }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "quote"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 }
      }
    },
    "legacyMechanismBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "evidenceRefs"],
      "properties": {
        "kind": { "enum": ["text", "source_image", "technical_flow_mermaid"] },
        "text": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "evidenceMechanismBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text", "evidenceRefs"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string", "minLength": 1 },
            "evidenceRefs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": { "$ref": "#/$defs/evidenceRef" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text", "assetPath", "alt", "evidenceRefs"],
          "properties": {
            "kind": { "enum": ["source_image", "technical_flow_mermaid"] },
            "text": { "type": "string", "minLength": 1 },
            "assetPath": {
              "type": "string",
              "pattern": "^assets/sha256/[a-f0-9]{64}\\.(?:png|svg)$"
            },
            "alt": { "type": "string", "minLength": 1 },
            "caption": { "type": "string", "minLength": 1 },
            "evidenceRefs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": { "$ref": "#/$defs/evidenceRef" }
            }
          }
        }
      ]
    },
    "deterministicRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "relationType", "direction", "basis"],
      "properties": {
        "target": { "$ref": "#/$defs/relationTarget" },
        "relationType": { "$ref": "#/$defs/relationType" },
        "direction": { "enum": ["undirected", "outbound", "inbound"] },
        "basis": { "type": "string", "minLength": 1 }
      },
      "allOf": [{ "$ref": "#/$defs/relationDirection" }]
    },
    "modelRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "relationType", "direction", "explanation"],
      "properties": {
        "target": { "$ref": "#/$defs/relationTarget" },
        "relationType": {
          "enum": [
            "same_problem",
            "depends_on",
            "integrates_with",
            "evolves_from",
            "implements"
          ]
        },
        "direction": { "enum": ["undirected", "outbound", "inbound"] },
        "explanation": { "type": "string", "minLength": 1 }
      },
      "allOf": [{ "$ref": "#/$defs/relationDirection" }]
    },
    "relationTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "insight" },
            "id": { "type": "string", "pattern": "^insight-[a-f0-9]{24}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "source" },
            "id": { "type": "string", "pattern": "^source-[a-f0-9]{24}$" }
          }
        }
      ]
    },
    "relationType": {
      "enum": [
        "same_object",
        "same_problem",
        "depends_on",
        "integrates_with",
        "alternative_to",
        "complements",
        "evolves_from",
        "implements"
      ]
    },
    "relationDirection": {
      "if": {
        "type": "object",
        "properties": {
          "relationType": { "enum": ["depends_on", "evolves_from", "implements"] }
        }
      },
      "then": {
        "type": "object",
        "properties": { "direction": { "enum": ["outbound", "inbound"] } }
      },
      "else": {
        "type": "object",
        "properties": { "direction": { "const": "undirected" } }
      }
    }
  }
}
