{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhot.example/contracts/publication-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publicationId",
    "candidate",
    "builderCompatibility",
    "entrypoints",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "publicationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineSha", "inputIdentity"],
      "properties": {
        "baselineSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "inputIdentity": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "builderCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "maxExclusive"],
      "properties": {
        "min": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "maxExclusive": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "insights", "sources"],
      "properties": {
        "home": { "type": "string", "pattern": "^data/[a-z0-9][a-z0-9._/-]*\\.json$" },
        "insights": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^data/insights/[a-z0-9][a-z0-9-]*\\.json$"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^data/sources/[a-z0-9][a-z0-9-]*\\.json$"
          }
        },
        "topics": {
          "type": "string",
          "pattern": "^data/topics\\.json$"
        },
        "timeline": {
          "type": "string",
          "pattern": "^data/timeline\\.json$"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mediaType", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mediaType": {
            "enum": ["application/json", "image/png", "image/svg+xml"]
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
