---
import type { HomePage } from "../content/model/home-page";

interface Props {
  brand: HomePage["brand"];
  homeUrl: string;
  timelineUrl?: string | undefined;
  topicsUrl: string | undefined;
  active: "home" | "timeline" | "topics";
}

const { brand, homeUrl, timelineUrl, topicsUrl, active } = Astro.props;
---

<header class="editorial-bar">
  <a class="brand-lockup" href={homeUrl} aria-label="DEVHOT 首页">
    <img class="brand-logo" src={brand.logoUrl} alt="CIMC" width="64" height="64" />
    <span class="brand-type">
      <strong>{brand.publication}</strong>
      <span>{brand.journal}</span>
    </span>
  </a>
  <nav class="reading-entry-nav" aria-label="阅读入口">
    {
      timelineUrl ? (
        <a
          data-reading-entry="timeline"
          href={timelineUrl}
          aria-current={active === "timeline" ? "page" : undefined}
        >
          时间线
        </a>
      ) : (
        <a data-reading-entry="timeline" aria-disabled="true">
          时间线
        </a>
      )
    }
    {
      topicsUrl ? (
        <a
          data-reading-entry="topics"
          href={topicsUrl}
          aria-current={active === "topics" ? "page" : undefined}
        >
          主题
        </a>
      ) : (
        <a data-reading-entry="topics" aria-disabled="true">
          主题
        </a>
      )
    }
  </nav>
  <p class="attribution">{brand.attribution}</p>
</header>
